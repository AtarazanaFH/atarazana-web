{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/manifesto.html",
      "destination": "/manifesto",
      "statusCode": 301
    },
    {
      "source": "/partners.html",
      "destination": "/partners",
      "statusCode": 301
    },
    {
      "source": "/en/index.html",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/en/manifesto.html",
      "destination": "/en/manifesto",
      "statusCode": 301
    },
    {
      "source": "/en/partners.html",
      "destination": "/en/partners",
      "statusCode": 301
    }
  ]
}
