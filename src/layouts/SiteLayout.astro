---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { pages, pageUrl, type Locale, type Page } from '../data/pages';
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/permanent-marker/400.css';
import '../styles/global.css';
type Meta = { title: string; description: string; socialDescription: string; type: string };
// Las páginas generadas (cada marea) pasan sus propios metadatos y rutas.
interface Props { lang: Locale; page: Page; meta?: Meta; paths?: Record<Locale, string>; }
const { lang, page, meta: metaOverride, paths } = Astro.props;
const meta: Meta = metaOverride ?? pages[lang][page];
const pathFor = (l: Locale) => paths?.[l] ?? pageUrl(l, page);
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(pathFor(lang));
const image = absolute(`/assets/social-preview-${lang}.png`);
const imageAlt = lang === 'es'
  ? 'Atarazana Founder House. Encuentros para la gente que construye tecnología en Málaga.'
  : 'Atarazana Founder House. Meetups for the people building technology in Málaga.';
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: 'Atarazana Founder House', url: canonical,
  email: 'atarazanafh@gmail.com', foundingDate: '2026', description: meta.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Málaga', addressCountry: 'ES' },
};
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <ClientRouter />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{meta.title}</title>
  <meta name="description" content={meta.description} />
  <meta name="theme-color" content="#061418" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="es" href={absolute(pathFor('es'))} />
  <link rel="alternate" hreflang="en" href={absolute(pathFor('en'))} />
  <meta property="og:type" content={meta.type} />
  <meta property="og:site_name" content="Atarazana Founder House" />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.socialDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:secure_url" content={image} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={meta.title} />
  <meta name="twitter:description" content={meta.socialDescription} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {page === 'index' && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  <script>
    import '../scripts/site.js';
  </script>
  <Analytics />
</head>
<body>
  <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <div class="meta-bar" aria-hidden="true">
    <div class="wrap meta-inner"><span>36.7202° N / 4.4214° W</span><span>Málaga / ES · s. XIV — 2026</span></div>
  </div>
  <Header lang={lang} page={page} alternate={pathFor(lang === 'es' ? 'en' : 'es')} />
  <main id="main">
    <slot />
    <FinalCTA lang={lang} />
  </main>
  <Footer lang={lang} />
</body>
</html>
