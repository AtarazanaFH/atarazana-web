---
import Logo from "./Logo.astro";
import type { Locale, Page } from '../data/pages';
import { pageUrl } from '../data/pages';
import { archiveLive, mareaUrl, nextMarea } from '../data/mareas';
interface Props { lang: Locale; page?: Page; alternate?: string; }
const { lang, page = 'index', alternate } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';
const copy = {
  "es": {
    "homeLabel": "Atarazana Founder House, inicio",
    "navLabel": "Principal",
    "aboutAnchor": "que-es",
    "about": "Qué es",
    "manifesto": "Manifiesto",
    "faq": "Preguntas",
    "otherLang": "en",
    "languageLabel": "Read in English",
    "invite": "Pide paso"
  },
  "en": {
    "homeLabel": "Atarazana Founder House, home",
    "navLabel": "Primary",
    "aboutAnchor": "what",
    "about": "What it is",
    "manifesto": "Manifesto",
    "faq": "FAQ",
    "otherLang": "es",
    "languageLabel": "Leer en español",
    "invite": "Request an invite"
  }
};
const t = copy[lang];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href={pageUrl(lang, "index")} aria-label={t.homeLabel}><Logo class="logo-mark" /><span class="logo-word">Atarazana<br>Founder House</span></a>
    <nav class="nav" aria-label={t.navLabel}>
      <a href={`${pageUrl(lang, "index")}#${t.aboutAnchor}`}>{t.about}</a>
      {archiveLive && <a href={mareaUrl(lang)} aria-current={page === "mareas" ? "page" : undefined}>Mareas</a>}
      <a href={pageUrl(lang, "manifesto")} aria-current={page === "manifesto" ? "page" : undefined}>{t.manifesto}</a>
      <a href={pageUrl(lang, "partners")} aria-current={page === "partners" ? "page" : undefined}>Partners</a>
      <a href={pageUrl(lang, "faq")} aria-current={page === "faq" ? "page" : undefined}>{t.faq}</a>
      <a href={alternate ?? pageUrl(otherLang, page)} class="nav-lang" hreflang={t.otherLang}>{t.languageLabel}</a>
      <a class="nav-cta" href={nextMarea.luma} target="_blank" rel="noopener">{t.invite}</a>
    </nav>
  </div>
</header>
