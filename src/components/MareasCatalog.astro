---
import type { Locale } from '../data/pages';
import { isPast, visibleMareas } from '../data/mareas';
import MareaRow from './MareaRow.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const upcoming = visibleMareas.filter((m) => !isPast(m)).reverse();
const archive = visibleMareas.filter(isPast);
const copy = {
  es: {
    kicker: 'Catálogo · Málaga',
    lead: 'Cada encuentro es una marea: vuelve cada poco, lleva número y, cuando pasa, se queda aquí con su programa y su gente.',
    count: (n: number) => `${n} ${n === 1 ? 'marea' : 'mareas'}`,
    next: 'Próxima',
    noNext: 'Todavía no hay fecha para la siguiente. Síguenos en Luma y te llega en cuanto la anunciemos.',
    follow: 'Seguir en Luma',
    archive: 'Archivo',
    noArchive: 'Aquí se irán quedando las mareas que ya hayan pasado.',
  },
  en: {
    kicker: 'Catalogue · Málaga',
    lead: 'We call each meetup a marea, Spanish for tide: it comes back often, it gets a number and, once it has passed, it stays here with its programme and its people.',
    count: (n: number) => `${n} ${n === 1 ? 'marea' : 'mareas'}`,
    next: 'Upcoming',
    noNext: 'There is no date for the next one yet. Follow us on Luma and you will hear as soon as we announce it.',
    follow: 'Follow on Luma',
    archive: 'Archive',
    noArchive: 'Past mareas will stay here.',
  },
};
const t = copy[lang];
---
<section class="hero mareas-hero reveal">
  <div class="wrap">
    <p class="kicker">{t.kicker}</p>
    <h1>Mareas</h1>
    <p class="lead">{t.lead}</p>
    <p class="mareas-count">{t.count(visibleMareas.length)} · 36.7202° N / 4.4214° W</p>
  </div>
</section>

<section class="mareas-block reveal" id="proxima">
  <div class="wrap">
    <div class="sec-head"><span>01</span><h2>{t.next}</h2></div>
    {upcoming.length
      ? <ul class="marea-list">{upcoming.map((m) => <MareaRow lang={lang} marea={m} />)}</ul>
      : <p class="mareas-empty">{t.noNext} <a class="text-link" href="https://luma.com/user/atarazana" target="_blank" rel="noopener">{t.follow}</a></p>}
  </div>
</section>

<section class="mareas-block band reveal" id="archivo">
  <div class="wrap">
    <div class="sec-head"><span>02</span><h2>{t.archive}</h2></div>
    {archive.length
      ? <ul class="marea-list">{archive.map((m) => <MareaRow lang={lang} marea={m} />)}</ul>
      : <p class="mareas-empty">{t.noArchive}</p>}
  </div>
</section>
