---
import type { Locale } from '../data/pages';
import { formatDate, nextMarea } from '../data/mareas';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = {
  "es": {
    "title": "Cuéntanos qué estás construyendo.",
    "description": `Pide paso en Luma con un enlace a lo que estás haciendo: tu web, tu GitHub, tu producto o un post. La Marea ${nextMarea.number} será el ${formatDate("es", nextMarea.date)}.`,
    "invite": "Pide paso",
    "contact": "O escríbenos a "
  },
  "en": {
    "title": "Tell us what you are building.",
    "description": `Request an invite on Luma with a link to what you are working on: your website, GitHub, product or a post. Marea ${nextMarea.number} will take place on ${formatDate("en", nextMarea.date)}.`,
    "invite": "Request an invite",
    "contact": "Or write to us at "
  }
};
const t = copy[lang];
---
<section class="final-cta reveal">
    <div class="laceria" aria-hidden="true"></div>
    <div class="wrap">
      <h2>{t.title}</h2>
      <p>{t.description}</p>
      <div class="final-actions">
        <a class="cta" href={nextMarea.luma} target="_blank" rel="noopener">{t.invite}</a>
        <span class="muted">{t.contact}<a href="mailto:atarazanafh@gmail.com">atarazanafh@gmail.com</a></span>
      </div>
    </div>
  </section>
