---
import Logo from "./Logo.astro";
import { pageUrl, type Locale } from '../data/pages';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const copy = {
  "es": {
    "homeLabel": "Atarazana Founder House, inicio",
    "description": "Encuentros para la gente que construye tecnología en Málaga.",
    "navLabel": "Enlaces",
    "home": "Inicio",
    "manifesto": "Manifiesto",
    "copyright": "© 2026 Atarazana Founder House · Hecho en Málaga"
  },
  "en": {
    "homeLabel": "Atarazana Founder House, home",
    "description": "Meetups for the people building technology in Málaga.",
    "navLabel": "Links",
    "home": "Home",
    "manifesto": "Manifesto",
    "copyright": "© 2026 Atarazana Founder House · Made in Málaga"
  }
};
const t = copy[lang];
---
<footer class="site-footer">
  <div class="wrap">
    <a class="footer-mark" href={pageUrl(lang, "index")} aria-label={t.homeLabel}><Logo /></a>
    <p class="footer-brand"><span class="footer-brand-name">Atarazana Founder House.</span><br>{t.description}</p>
    <nav class="footer-links" aria-label={t.navLabel}>
      <a href="https://luma.com/user/atarazana" target="_blank" rel="noopener">Luma</a>
      <a href="https://x.com/atarazanafh" target="_blank" rel="noopener">X</a>
      <a href="mailto:atarazanafh@gmail.com">atarazanafh@gmail.com</a>
      <a href={pageUrl(lang, "index")}>{t.home}</a>
      <a href={pageUrl(lang, "manifesto")}>{t.manifesto}</a>
      <a href={pageUrl(lang, "partners")}>Partners</a>
    </nav>
    <p class="footer-meta"><span>{t.copyright}</span><span>36.7202° N / 4.4214° W · Málaga / ES</span></p>
  </div>
</footer>
