---
import type { Locale } from '../data/pages';
import { isPast, type Marea } from '../data/mareas';
import SpeakerPoster from './SpeakerPoster.astro';
// posters={false} cuando la página ya abre los carteles en otro sitio (los ids no se pueden repetir).
interface Props { lang: Locale; marea: Marea; heading?: boolean; posters?: boolean; }
const { lang, marea, heading = true, posters = true } = Astro.props;
const copy = {
  es: { title: 'Programa previsto', pastTitle: 'Programa', arrival: 'Entrada', arrivalLine: 'Llegar y acomodarnos', talk: 'Tiempo para hablar', talkLine: 'Un espacio para conocernos y conversar libremente' },
  en: { title: 'Planned programme', pastTitle: 'Programme', arrival: 'Arrival', arrivalLine: 'Come in and settle in', talk: 'Time to chat', talkLine: 'Space to get to know each other and talk freely' },
};
const t = copy[lang];
---
{heading && <h3 class="lineup-title">{isPast(marea) ? t.pastTitle : t.title}</h3>}
<ul class="lineup">
  <li><span class="lineup-item">{t.arrival}<small>{t.arrivalLine}</small></span></li>
  {marea.talks.map((talk) => (
    <li>
      <span class="lineup-item">{talk.title[lang]}<small>{talk.line[lang]}</small></span>
      {posters && talk.poster
        ? <SpeakerPoster name={talk.speaker} slug={talk.poster} lang={lang} />
        : <span class="tag tag--solid">{talk.speaker}</span>}
    </li>
  ))}
  <li><span class="lineup-item">{t.talk}<small>{t.talkLine}</small></span></li>
</ul>
