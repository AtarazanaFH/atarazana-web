# PRODUCCIÓN. Copia este archivo a .env.prod y rellénalo (Supabase → Project Settings → API).
# Solo lo usa `node scripts/mercado.mjs ... --prod`. Astro no lo carga nunca. No se sube al repo.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://atarazana.house

# La web publicada lee PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY de Vercel → Settings → Environment Variables.
# En local, `npm run dev` usa .env.development.local, que apunta al Supabase local y a nada más.
