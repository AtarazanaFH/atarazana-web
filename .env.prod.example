# PRODUCCIÓN. Copia este archivo a .env.prod y rellénalo (Supabase → Project Settings → API Keys; SUPABASE_SERVICE_ROLE_KEY es la secret key, sb_secret_…).
# Solo lo usa `node scripts/tripulacion.mjs ... --prod`. Astro no lo carga nunca. No se sube al repo.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://atarazana.house

# Contraseña de aplicación de Gmail: scripts/tripulacion.mjs manda las invitaciones con ella.
GMAIL_APP_PASSWORD=

# Solo para que un agente aplique el esquema y la configuración por la API de gestión. Caduca; se renueva en
# https://supabase.com/dashboard/account/tokens (ver "Acceso de agentes" en AGENTS.md).
SUPABASE_ACCESS_TOKEN=

# La web publicada lee PUBLIC_SUPABASE_URL y PUBLIC_SUPABASE_ANON_KEY de Vercel → Settings → Environment Variables.
# En local, `npm run dev` usa .env.development.local, que apunta al Supabase local y a nada más.
